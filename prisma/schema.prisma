// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model CustomerToken {
  id              String    @id
  conversationId  String
  accessToken     String
  refreshToken    String?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([conversationId])
}

model CodeVerifier {
  id              String    @id
  state           String    @unique
  verifier        String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime

  @@index([state])
}

model Conversation {
  id            String    @id
  customerEmail String?
  customerName  String?
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" or "assistant"
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model CustomerAccountUrls {
  id               String    @id @default(cuid())
  conversationId   String    @unique
  mcpApiUrl        String?
  authorizationUrl String?
  tokenUrl         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Note {
  id        String    @id @default(cuid())
  name      String    @unique
  position  String
  density   Float
  family    String?
  createdAt DateTime  @default(now())
}

model OrderHistory {
  id             String    @id @default(cuid())
  orderDate      String?
  season         String?
  classification String?
  notes          String
  // Region columns only — deliberately not restoring Name/Race/Gender from the source CSV,
  // matching the original seed script's privacy-conscious scope (see scripts/seed-notes.cjs).
  city           String?
  stateName      String?
  countryName    String?
  // Real DUA product referenced by this historical order — 100% populated in the source CSV,
  // unlike Name/Race/Gender this isn't privacy-sensitive, so unlike those it's kept.
  productName           String?
  normalizedProductName String?
  // A one-way, salted (HMAC) hash of the source row's customer name — never the name itself,
  // never reversible without the secret salt (CUSTOMER_KEY_HASH_SALT, env-only, never committed).
  // Exists ONLY so repeat-purchase patterns can be counted (same hash appearing more than once =
  // same underlying customer) without ever storing or exposing who that customer actually is.
  // Never returned in any tool output or customer-facing text — aggregate counts only.
  customerKeyHash String?
  createdAt      DateTime  @default(now())

  @@index([city])
  @@index([stateName])
  @@index([countryName])
  @@index([normalizedProductName])
  @@index([customerKeyHash])
}

model FragranceProduct {
  id              String   @id @default(cuid())
  handle          String?
  title           String
  normalizedTitle String   @unique
  notesRaw        String?
  notesJson       Json?
  fragranceFamily String?
  collection      String?
  pricePer5ml     Float?
  // Populated from the "Inspirations" sheet in data/Notes-Extraction-Separated-hybird.xlsx
  // (scripts/import-hybrid-catalog.cjs) — matched onto an existing row by normalized title/handle,
  // never used to create a new product. Null for products the Inspirations sheet doesn't cover
  // (e.g. Hybrid/Tribrid/Quadbrid finished products, which aren't themselves single inspirations).
  tagLine             String?
  inspirationName     String?
  inspirationBrand    String?
  isSingleInspiration Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fragranceFamily])
  @@index([collection])
}

// Odoo oil-inventory integration — explicit DUA product <-> Odoo fragrance-oil SKU mapping. SKU is
// the approved production lookup key; display names are never used as production truth (fuzzy
// name matching may only ever suggest a mapping for staff review, never decide it). Starts empty —
// real mappings are added after this implementation lands, not backfilled by it.
model OdooOilMapping {
  id                 String    @id @default(cuid())
  fragranceProductId String    @unique
  odooSku            String    @unique
  odooProductId      Int?
  odooVariantId      Int?
  odooName           String?
  unitOfMeasure      String?
  active             Boolean   @default(true)
  lastVerifiedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([odooSku])
}

model ExistingCombination {
  id                    String   @id @default(cuid())
  title                 String
  normalizedTitle       String
  // HYBRID | TRIBRID | QUADBRID
  type                  String
  componentProductsJson Json
  // Order-independent key (see app/utils/combinationKey.js) so "A+B" and "B+A" are the same row.
  componentKey          String   @unique
  tagLine               String?
  createdAt             DateTime @default(now())

  @@index([type])
}

model FragranceRecommendation {
  id                  String    @id @default(cuid())
  conversationId      String
  customerProfileJson Json
  // Real source product titles/notes/roles — internal only (Shopify creation, backend analysis).
  // Fix 3: never read directly by the frontend or the model's customer-facing narration; those
  // consumers use the customerFacingJson fields below instead.
  productsJson        Json
  combinationType      String
  scoreJson            Json
  evidenceJson         Json
  ratiosJson           Json
  // Fix 9: the deterministic tier of real historical evidence backing this recommendation —
  // "city"|"state"|"country"|"season_global"|"global"|"limited". Persisted (not just computed at
  // generation time) so a later retry/rehydration renders the exact same wording tier.
  evidenceScope        String?
  // Fix 3: customerFacingName/Description/WhySuits/BestUse/WeatherSuitability/Strength/Risk —
  // the only fields any customer-facing surface (SSE payload, recommendation card, chat text) may
  // ever read from this record.
  customerFacingJson   Json?
  // pending | confirmed | expired
  status               String    @default("pending")
  createdAt            DateTime  @default(now())
  confirmedAt          DateTime?
  shopifyProductId     String?
  // Fix (fragrance preview page) — Shopify product creation is now DEFERRED until the customer
  // clicks Save Build or Add to Cart on the preview page (never automatically on chat confirm).
  // draft while only previewed/edited; SAVED once Save Build has actually created/resolved a real
  // Shopify product+variant. shopifyVariantId is the specific ratio-variant last created/resolved
  // (a distinct variant per distinct ratio — see app/services/fragranceBuild.server.js).
  buildStatus          String    @default("draft")
  shopifyVariantId     String?
  // Customer edits made on the preview page — a customer-renamed fragrance name, notes they chose
  // to exclude from display, and the last top/middle/base percentages they landed on. All optional;
  // null/empty means "use the deterministic defaults" (customerFacingName, no exclusions, the
  // ratios computed from computeNotePositionBuckets/computeRatios).
  draftName             String?
  draftExcludedNotes    Json?
  draftRatiosJson       Json?

  @@index([conversationId])
  @@index([status])
}

// Precomputed per Phase 12's performance requirement: a live groupBy of OrderHistory (936k rows)
// scoped to a broad tier like country="United States" (87% of the table) measured ~12s per query
// in testing — too slow for a live chat request. This table holds the same three tiers
// analyzeCustomerProductCandidates needs (country, state, season — city is left live, since a
// single city's real row count is always small enough to query directly) plus each product's
// single most common classification, all computed once by scripts/build-region-summary.cjs
// instead of re-aggregated on every request.
model ProductRegionSummary {
  id                    String   @id @default(cuid())
  normalizedProductName String
  // "country" | "state" | "season" | "classification_global"
  scope                 String
  // the country/state/season name, or (for classification_global) the classification string
  scopeValue            String
  orderCount            Int
  // 0 for the classification_global scope, which isn't customer-scoped
  distinctCustomerCount Int
  repeatCustomerCount   Int
  updatedAt             DateTime @updatedAt

  @@unique([normalizedProductName, scope, scopeValue])
  @@index([scope, scopeValue])
}

// Phase 1's CustomerFragranceProfile, stored separately from raw conversation history and
// validated by the backend (app/services/customerProfile.server.js) — not left to the model's own
// memory of which turn it's on. One row per conversation, durable across server restarts (mirrors
// how Conversation/Message already persist history outside the in-memory CONVERSATIONS cache in
// chat.jsx). profileJson holds the whole CustomerFragranceProfile object; re-saved as a whole on
// every field update rather than split into individual columns, since it's always read/written as
// one unit and never queried by individual field.
model CustomerProfileState {
  id             String   @id @default(cuid())
  conversationId String   @unique
  profileJson    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId])
}
