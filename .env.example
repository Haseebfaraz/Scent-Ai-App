# Standalone Python FastAPI backend (separate repo: dua-scent-ai-python, separate Render service)
# -- chat.jsx proxies here instead of calling OpenAI directly. INTERNAL_API_KEY must match the
# same value configured on that service exactly (sent as the X-Internal-Api-Key header).
PYTHON_BACKEND_URL=http://localhost:8000
INTERNAL_API_KEY=YOUR_SHARED_INTERNAL_API_KEY
