{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div class="scent-architect-section-wrapper" id="scent-ai-chat-bot">
  <div class="scent-architect-container">
    
    <div class="scent-architect-branding-col">
      <div class="brand-icon-box">
        <div class="inner-brand-symbol"></div>
      </div>
      
      <h2 class="scent-architect-title">Dua Scent Agent</h2>
      <p class="scent-architect-description">
        Our intelligence engine analyzes your aesthetic preferences, memories, and desired mood to synthesize a one-of-a-kind molecular fragrance profile.
      </p>
      
      <div class="scent-pill-grid">
        <span class="scent-pill" data-scent="Oriental">ORIENTAL</span>
        <span class="scent-pill" data-scent="Spicy Woody">SPICY WOODY</span>
        <span class="scent-pill" data-scent="Chypre">CHYPRE</span>
        <span class="scent-pill" data-scent="Aromatic">AROMATIC</span>
        <span class="scent-pill" data-scent="Fruity">FRUITY</span>
        <span class="scent-pill" data-scent="Citrus">CITRUS</span>
      </div>
    </div>

    <div class="scent-architect-interface-col">
      {% if customer %}
      <div class="shop-ai-chat-container" style="--scent-accent: {{ block.settings.chat_bubble_color }};">

        <div class="shop-ai-chat-bubble" style="display: none !important;"></div>

        <div class="shop-ai-chat-window">

          <div class="scent-interface-header">
            <div class="header-left-meta">
              <div class="meta-icon-square">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                  <rect x="9" y="2" width="6" height="3" rx="1"/>
                  <rect x="10" y="5" width="4" height="3"/>
                  <rect x="6" y="8" width="12" height="13" rx="3"/>
                </svg>
              </div>
              <div class="meta-text-lines">
                <span class="meta-label-top">Dua Scent Agent</span>
                <span class="meta-label-sub"><span class="status-pulse-dot"></span>Online · Fragrance Expert</span>
              </div>
            </div>
            <div class="header-right-status">
              <span class="traffic-dot traffic-dot-red"></span>
              <span class="traffic-dot traffic-dot-yellow"></span>
              <span class="traffic-dot traffic-dot-green"></span>
            </div>
            <button class="shop-ai-chat-close" style="display: none !important;">✕</button>
          </div>

          <div class="shop-ai-chat-messages"></div>

          <div class="shop-ai-chat-input">
            <input type="text" placeholder="{{ 'chat.inputPlaceholder' | t }}">
            <button class="shop-ai-chat-send">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>

        </div>
      </div>

      <script src="{{ 'chat.js' | asset_url }}" defer></script>
      <script>
        window.shopChatConfig = {
          promptType: {{ block.settings.system_prompt | json }},
          welcomeMessage: {{ block.settings.welcome_message | json }}
        };
        window.shopId = {{ shop.id }};
        window.shopDomain = {{ shop.permanent_domain | json }};
        window.appBaseUrl = {{ block.settings.app_base_url | json }};
        // Real, verified Shopify account info — only ever rendered inside the logged-in branch
        // above, so chat.js (loaded only here) can trust these directly with no client-side gate
        // of its own. Logged-out visitors never receive this script or chat.js at all. Name falls
        // back first_name -> full name -> null (never guessed from the email — accounts created
        // via New Customer Accounts' email+OTP sign-in have no name field at all, and a guess like
        // "Haseebfaraz2000" from the email's local part reads worse than just asking in chat).
        window.shopCustomerEmail = {% if customer %}{{ customer.email | json }}{% else %}null{% endif %};
        window.shopCustomerName = {%- if customer -%}
          {%- if customer.first_name != blank -%}
            {{ customer.first_name | json }}
          {%- elsif customer.name != blank -%}
            {{ customer.name | json }}
          {%- else -%}
            null
          {%- endif -%}
        {%- else -%}
          null
        {%- endif -%};
      </script>
      {% else %}
      <div class="shop-ai-chat-container">
        <div class="shop-ai-chat-window shop-ai-login-gate">
          <div class="scent-interface-header">
            <div class="header-left-meta">
              <div class="meta-icon-square">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                  <rect x="9" y="2" width="6" height="3" rx="1"/>
                  <rect x="10" y="5" width="4" height="3"/>
                  <rect x="6" y="8" width="12" height="13" rx="3"/>
                </svg>
              </div>
              <div class="meta-text-lines">
                <span class="meta-label-top">Dua Scent Agent</span>
                <span class="meta-label-sub">Sign in required</span>
              </div>
            </div>
          </div>
          <div class="shop-ai-login-gate-body">
            <p class="shop-ai-login-gate-title">Sign in to chat</p>
            <p class="shop-ai-login-gate-subtitle">Create your custom fragrance by chatting with Dua Scent Agent — sign in to your account first so we can save your build.</p>
            <a class="shop-ai-login-gate-button" href="/customer_authentication/login?return_to={{ routes.root_url | url_encode }}">Sign In to Chat</a>
          </div>
        </div>
      </div>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "section",  
  "settings": [
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Chat Bubble Color",
      "default": "#ab9372"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "Hi there! How's your day going so far?"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "System Prompt",
      "options": [
        {
          "value": "standardAssistant",
          "label": "Standard Assistant"
        },
        {
          "value": "enthusiasticAssistant",
          "label": "Enthusiastic Assistant"
        }
      ],
      "default": "standardAssistant"
    },
    {
      "type": "text",
      "id": "app_base_url",
      "label": "App Base URL (dev only)",
      "info": "Your app's current backend URL, e.g. https://localhost:3458 or your current ngrok/tunnel URL. Update this whenever your local dev port or tunnel changes — no code redeploy needed.",
      "default": "https://localhost:3458"
    }
  ]
}
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.scent-pill');
    const chatInput = document.querySelector('.shop-ai-chat-input input');
    const sendButton = document.querySelector('.shop-ai-chat-send');

    if (!chatInput || !sendButton) return;

    pills.forEach(pill => {
      pill.style.cursor = 'pointer';
      pill.addEventListener('click', () => {
        const preferredScent = pill.getAttribute('data-scent');
        chatInput.value = `My preferred fragrance classification is ${preferredScent}.`;
        sendButton.click();
      });
    });

    function attachStreamRedirectListener() {
      if (window.appChatEventSource) {
        console.log("Dua Scent Agent stream detected. Registering redirection listeners...");
        
        window.appChatEventSource.addEventListener('message', (event) => {
          try {
            const data = JSON.parse(event.data);
            if (data.type === 'REDIRECT_TO_BESPOKE_CANVAS') {
              const productHandle = data.payload.handle;
              sessionStorage.setItem('active_scent_layers', JSON.stringify(data.payload.layers));
              sessionStorage.setItem('active_scent_title', data.payload.title);
              sessionStorage.setItem('active_scent_description', data.payload.description);
              window.location.href = `/products/${productHandle}`;
            }
          } catch (err) {
            console.error("Error parsing stream payload:", err);
          }
        });
        return true;
      }
      return false;
    }

    if (!attachStreamRedirectListener()) {
      const checkStreamInterval = setInterval(() => {
        if (attachStreamRedirectListener()) {
          clearInterval(checkStreamInterval);
        }
      }, 250);
      setTimeout(() => clearInterval(checkStreamInterval), 10000);
    }
  });
</script>